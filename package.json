  "license": "MIT",
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.0.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "echarts": "^5.5.0",
    "esbuild": "0.21.5",
    "jsdom": "^29.1.1",
    "obsidian": "latest",
    "tslib": "2.6.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^5.2.3"
  }
}
