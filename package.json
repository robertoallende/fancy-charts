{
  "name": "fancy-charts",
  "version": "0.1.0",
  "description": "Interactive charts inside any note, powered by ECharts.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "wdio run ./wdio.conf.mts",
    "test:e2e:local": "wdio run ./bash/wdio.conf.local.mts"
  },
  "keywords": [],
  "author": "Roberto Allende",
  "license": "MIT",
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.0.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@wdio/cli": "^9.30.0",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "echarts": "^5.5.0",
    "esbuild": "0.21.5",
    "jsdom": "^29.1.1",
    "obsidian": "latest",
    "tslib": "2.6.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.10",
    "wdio-obsidian-reporter": "^3.1.1",
    "wdio-obsidian-service": "^3.1.1"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
